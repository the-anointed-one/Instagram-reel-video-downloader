# ── Server ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Redis ─────────────────────────────────────────────────────────
# Local:  redis://localhost:6379
# Render: use the Internal Redis URL provided by Render
REDIS_URL=redis://localhost:6379

# ── CORS ──────────────────────────────────────────────────────────
# Your frontend origin (no trailing slash)
FRONTEND_URL=http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────────
# Max requests per window per IP
RATE_LIMIT_MAX=20
# ── Rate Limiting ─────────────────────────────────────────────
# Max requests per window per IP
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=900000

# ── yt-dlp Path ───────────────────────────────────────────────────
# For Render/production with build.sh: use ./bin/yt-dlp
# For local development: leave empty if yt-dlp is in system PATH
YTDLP_PATH=./bin/yt-dlp

# ── YouTube Authentication ───────────────────────────────────────
# YouTube now requires authentication to bypass bot detection.
# 
# Option 1: Export cookies from logged-in browser
#   - Use "Get cookies.txt LOCALLY" Chrome extension
#   - Download the cookies.txt file and upload to your server
#   - Set: YTDLP_COOKIES_FILE=/absolute/path/to/cookies.txt
#
# Option 2: For serverless (Vercel/Render), encode cookies as base64
#   - Set: YTDLP_COOKIES_CONTENT=base64:BASE64_ENCODED_CONTENT
#   - Or paste raw cookies.txt content directly
#
# Without cookies, YouTube extraction will fail with bot detection blocks.
# YTDLP_COOKIES_FILE=/absolute/path/to/youtube-cookies.txt
# YTDLP_COOKIES_CONTENT=

# ── Cobalt API Fallback ──────────────────────────────────────────
# If yt-dlp fails (e.g., YouTube blocks the IP), fallback to Cobalt API.
# 
# Self-host a free Cobalt instance:
#   - Deploy on Railway: https://railway.app/ (free tier available)
#   - Cobalt repo: https://github.com/imputnet/cobalt
#   - Then set the deployed URL here:
#
# COBALT_API_URL=https://your-cobalt-instance.up.railway.app

# ── Tools: AI Detector / Plagiarism (Copyleaks) ──────────────────
# Sign up at https://api.copyleaks.com and create an API key.
# Both the AI Content Detector and (later) the Plagiarism Checker use these.
# COPYLEAKS_EMAIL=you@example.com
# COPYLEAKS_API_KEY=your_copyleaks_api_key
# Keep sandbox=true while testing (mock results, no credits used); set false to go live.
COPYLEAKS_SANDBOX=true

# ── Tools: AI Image Detector (Sightengine) ───────────────────────
# Sign up at https://sightengine.com and grab your API user + secret.
# SIGHTENGINE_USER=your_api_user
# SIGHTENGINE_SECRET=your_api_secret

# ── Tools: LLM text tools (Claude) ───────────────────────────────
# Powers summarizer, paraphraser, grammar, translator, caption, hashtag, bio.
# Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# Model default is claude-opus-4-8. For these high-volume free tools you may
# prefer claude-haiku-4-5 to cut cost dramatically — your call.
# AI_MODEL=claude-opus-4-8

# ── Tools: Subtitle Generator (Deepgram) ─────────────────────────
# Speech-to-text for the subtitle generator. Get a key at https://deepgram.com
# DEEPGRAM_API_KEY=...
# Max upload size (bytes) for the subtitle generator. Default 25MB (safe for
# small backend instances; raise if you have more RAM headroom).
TOOLS_SUBS_MAX_BYTES=26214400

# ── Tools: cost controls ─────────────────────────────────────────
# Hard monthly ceiling on paid tool calls per category (kill-switch). 0 = uncapped.
TOOLS_MONTHLY_MAX_CHECKS=5000
# Free daily uses of premium (API-cost) tools per IP before the upgrade prompt.
# 0 = unlimited (gate OFF) — keep 0 until Paystack payments are live, then set e.g. 3.
TOOLS_FREE_DAILY=0
# Max characters accepted per free AI-detector check (bounds cost per call).
TOOLS_AI_DETECTOR_MAX_CHARS=1500
# Max image upload size (bytes) for the AI image detector. Default 8MB.
TOOLS_AI_IMAGE_MAX_BYTES=8388608

